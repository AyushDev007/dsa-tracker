# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local Docker:  postgresql://dsa:dsa@localhost:5432/dsa_tracker?schema=public
# Neon (free):   copy the "pooled" connection string from the Neon dashboard
DATABASE_URL="postgresql://dsa:dsa@localhost:5432/dsa_tracker?schema=public"

# Direct (non-pooled) URL, used by `prisma migrate`. On Neon/Supabase set this
# to the *unpooled* connection string. Locally, just mirror DATABASE_URL.
DIRECT_URL="postgresql://dsa:dsa@localhost:5432/dsa_tracker?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Required in production (your deployed origin). Not needed locally.
# AUTH_URL="https://your-app.vercel.app"

# Set to true only on Vercel/behind a proxy.
AUTH_TRUST_HOST="true"

# GitHub OAuth  -> https://github.com/settings/developers
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth  -> https://console.cloud.google.com/apis/credentials
#   Authorised JS origin:  http://localhost:3000
#   Redirect URI:          http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Local development escape hatch
# ---------------------------------------------------------------------------
# When "true", a one-click "Continue as demo user" button appears on /signin so
# you can use the whole app before setting up any OAuth app.
# This provider refuses to load when NODE_ENV=production.
ENABLE_DEV_LOGIN="true"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
