{
  "name": "dsa-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-db.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx scripts/demo-data.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "problems:build": "tsx scripts/build-problems.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "highlight.js": "11.11.1",
    "lucide-react": "1.28.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "9.39.0",
    "eslint-config-next": "15.5.22",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true,
    "@embedded-postgres/windows-x64": true
  }
}
